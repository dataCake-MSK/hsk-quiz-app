# 실제 값은 .env에만 적고 커밋하지 않는다. 여기에는 변수 이름과 형식만 남긴다.

# CORS 허용 출처(쉼표로 구분). 비워 두면 브라우저의 교차 출처 요청을 허용하지 않는다.
# 예: http://localhost:8081,http://localhost:19006
CORS_ORIGINS=

# 요청 횟수 제한 (slowapi 형식: "<횟수>/<기간>")
PUBLIC_RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=5/minute

# SRS-004 이후 사용
# DATABASE_URL=
# TEST_DATABASE_URL=
# SRS-011 이후 사용
# JWT_SECRET=
